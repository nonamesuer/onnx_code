    border-color: red;
    background: yellow;
}

.QCheckBox::indicator:indeterminate:hover {
    border-color: darkred;
} */


/* statusbar */
#label_statusbar{
    background-color: #313a46;
    color: #fff;
    
}
/* title widget */
/* btn_hide */
#btn_hidemenu {
    padding: 5px;
    border: none;
    width: 30px;
    height: 30px
}
/* #label_title{
    font-size: 25px;
    font-weight: 900;
    padding-left: 15px;
} */
#comboBox_lang{
    border-bottom: 1px solid #ccc;
    border-radius: 1px;
    padding: 2px;
    width: 20px;
    font-size: 18px;
    background-color: white;
}
#comboBox_lang::drop-down{
    width: 20px;
    border-bottom-width: 1pk;
    border-bottom-color: #ccc;
    border-bottom-style: solid;
    image: url(static/icon/arrow_down.ico) no-repeat center center; 
}
/* QComboBox 下拉列表样式 */
#comboBox_lang QAbstractItemView {
    border: 1px solid #ccc; /* 列表边框颜色 */
    background-color: #efeff0; /* 列表背景颜色 */
}

/* 设置按钮 */
#btn_mainset {
    padding: 5px;
    border: none;
    width: 30px;
    height: 30px
}
/* yolo */
.QFrame{
    background-color: #e0e2e5;
}
.QTabWidget{
    background-color: #e0e2e5;
}
.QTabWidget::pane{
    background-color: #eff1f2;
    border-top:1px solid rgb(91, 90, 90);background:transparent;
}
 /* .QTabWidget::tab-bar{
    background-color: #fff;
 } */
.QTabBar::tab{
    font-size:15px;
    font-weight:bold;
    width: 150px;
    height: 30px;
    background-color: #e0e2e5;
    /* background-color: #fff; */
}
.QTabBar::tab:hover { background-color: #71767c; }
.QTabBar::tab:selected { background-color: #007bc0; }
