    width: 60px;
    height: 38px;
    /* border-radius: 1px; */
    /* padding: 2px; */
    font-size: 18px;
    /* background-color: #e0e2e5; */
}
/* dialog_ignore */
#Dialog_Ignore .QPushButton{
    font-size: 20PX;
    color: #007bc0;
    border: 1px solid #007bc0;
    font-weight:900;
    height: 40px;
    padding: 0 10px;
}
#Dialog_Ignore .QPushButton:focus{
    background-color: #d1e4ff;
}
#Dialog_Ignore #label_Title{
    font-size: 25px;
    font-weight: 900;
    padding-left: 15px;
}
#Dialog_Ignore #label_Text1{
    font-size: 25px;
    font-weight: 500;

}
#Dialog_Ignore .QLineEdit{
    background-color: #e0e2e5;
    font-size: 25px;
    font-weight: 600;
    border:none;
    border-bottom: 1px solid #000;
}
#Dialog_Ignore .QLineEdit:active{
    background-color: #d1e4ff;
    border-bottom:2px solid #000;
}

