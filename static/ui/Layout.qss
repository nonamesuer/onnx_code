   /* QComboBox 下拉列表样式 */
.QComboBox{
    border-bottom: 1px solid #000;
    border-radius: 1px;
    padding: 2px;
    /* width: 20px; */
    font-size: 18px;
    background-color: #e0e2e5;
}
.QComboBox::drop-down{
    width: 20px;
    /* border-bottom: 1px solid #000; */
    image: url(static/icon/arrow_down.ico) no-repeat center center; 
}

.QComboBox QAbstractItemView {
    border: 1px solid #ccc; /* 列表边框颜色 */
    background-color: #efeff0; /* 列表背景颜色 */
}
#comboBox_tab3_results{
    width: 50px;
}
#yolo #btn_tab1_closecamera,
#yolo #btn_tab1_opencamera{
    background-color: #fff;
    border: 1px solid #007bc0;
    color: #007bc0;
    font-weight: normal;
}
#yolo #btn_tab1_closecamera:hover,
#yolo #btn_tab1_opencamera:hover{
    background-color: #d1e4ff;
}

#yolo #btn_tab1_takepicture{
    margin-left: 20px;
    font-weight: 400;
}
#yolo #radioButton_tab3_continue,#yolo #radioButton_tab3_pausereset,#yolo #radioButton_tab3_pause{
    height: 100%;
    margin-left: 10px;
    border:none;
}

