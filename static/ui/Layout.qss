
#yolo .QPushButton{
    font-size: 20PX;
    background-color: #007bc0;
    color: #FFF;
    height: 40px;
    padding: 0 10px;
}
#yolo .QPushButton:hover,#JsonToYolo #btn_start:hover{
    background-color: #00629a
}
#yolo #checkBox_tab3_pause{
    margin-left: 20px;
    color: red;
}
#yolo #tab_4 .QPushButton{
    background-color: #ffffff;
    height: 100px;
    /* width:150px; */
    padding:10px;
    font-size: 30PX;
    color: #007bc0;
    border-bottom: 3px solid #939aa3;
    border-left:2px solid #939aa3;
    border-right:2px solid #939aa3;
    border-top:1px solid #939aa3;
}
#yolo #tab_4 .QPushButton:hover{
    background-color: #d5d3d3;
}
#yolo .QToolButton{
    border:1px solid #71767c
    /* background-color: #007bc0; */
}
#yolo #btn_rexlogo{
    /* border-image: url(static/img/rex_logo.jpg); */
    background-color:transparent;
}
#yolo #btn_teflogo{
    border-image: url(static/img/bosch.26cf9c8e.svg);
    background-color:transparent;
}
/* 公共-多选框 */
.QCheckBox::indicator {
    width: 20px;
    height: 20px;
}

.QCheckBox::indicator:unchecked {
    background-color: #8a9097;
}

.QCheckBox::indicator:checked {
    background-color: #007bc0;
    image: url("static/img/checkbox.png");
}

.QCheckBox::indicator:checked:hover {
    background-color: #015e93;
}

.QCheckBox::indicator:unchecked:hover {
    background-color: #71767c;
}

